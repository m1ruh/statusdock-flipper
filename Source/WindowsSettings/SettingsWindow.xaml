<Window x:Class="StatusDockPreview.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StatusDock Settings" Width="590" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#F5F3EF" Foreground="#262420" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" xml:lang="en">
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#5D5953" />
        </Style>
        <Style x:Key="DisplayChoice" TargetType="RadioButton">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Foreground" Value="#262420" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="White" BorderBrush="#D7D2C9"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="16" Margin="0,0,9,0">
                                    <Ellipse x:Name="Ring" Stroke="#6F6A62" StrokeThickness="1.5" />
                                    <Ellipse x:Name="Dot" Margin="4" Fill="#8A4C12" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FCF7EF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FFF3E0" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#A46320" />
                                <Setter TargetName="Ring" Property="Stroke" Value="#8A4C12" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#2C6087" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Card" Property="Padding" Value="11,9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,19,22,16">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="StatusDock Settings" FontWeight="SemiBold" FontSize="29" />
                    <TextBlock Text="Flipper display settings" Foreground="#5D5953" Margin="0,2,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right" VerticalAlignment="Top" Margin="0,6,0,0"
                        Padding="9,4" CornerRadius="9">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#E9E3D8" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=DataLabel}" Value="Live">
                                    <Setter Property="Background" Value="#D1E9D9" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="DataLabel" Text="Sample data" Style="{StaticResource SectionLabel}" />
                </Border>
            </DockPanel>
            <DockPanel Margin="0,21,0,7">
                <TextBlock DockPanel.Dock="Right" Text="128 × 64 px" Style="{StaticResource SectionLabel}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PREVIEW" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="NoLiveLabel" Text="No live data" Margin="12,0,0,0"
                               Foreground="#8A4C12" Style="{StaticResource SectionLabel}" />
                </StackPanel>
            </DockPanel>
            <Border Background="#2B2824" CornerRadius="12" Padding="12">
                <Image x:Name="PreviewImage" MaxWidth="512" MaxHeight="256" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       AutomationProperties.Name="Flipper display preview" />
            </Border>
            <TextBlock Text="DISPLAY" Margin="0,19,0,7" Style="{StaticResource SectionLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="StatsChoice" GroupName="Display" Content="PC Stats"
                             Style="{StaticResource DisplayChoice}" Checked="OnChoiceChanged" />
                <RadioButton x:Name="ClockChoice" Grid.Column="2" GroupName="Display" Content="Large Clock"
                             Style="{StaticResource DisplayChoice}" Checked="OnChoiceChanged" />
            </Grid>
            <Border Margin="0,10,0,0" Padding="12,10" Background="White"
                    BorderBrush="#D7D2C9" BorderThickness="1" CornerRadius="8">
                <CheckBox x:Name="SecondsChoice" Content="Show seconds"
                          Checked="OnChoiceChanged" Unchecked="OnChoiceChanged" />
            </Border>
            <TextBlock x:Name="SaveStatus" Margin="0,12,0,0" Foreground="#5D5953" FontSize="12"
                       Text="Settings are saved automatically in this folder." TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
