<Window x:Class="StatusDockPreview.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StatusDock Settings" Width="590" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource MainText}"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" xml:lang="en">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary x:Key="DarkTheme">
                <SolidColorBrush x:Key="WindowBackground" Color="#1E1C1A" />
                <SolidColorBrush x:Key="MainText" Color="#F6EEE4" />
                <SolidColorBrush x:Key="MutedText" Color="#C4BAB0" />
                <SolidColorBrush x:Key="Surface" Color="#2A2724" />
                <SolidColorBrush x:Key="Outline" Color="#514940" />
                <SolidColorBrush x:Key="ControlOutline" Color="#A49A8F" />
                <SolidColorBrush x:Key="Hover" Color="#35302A" />
                <SolidColorBrush x:Key="Selected" Color="#3C2E21" />
                <SolidColorBrush x:Key="SelectedOutline" Color="#B8824D" />
                <SolidColorBrush x:Key="Accent" Color="#FFB866" />
                <SolidColorBrush x:Key="Focus" Color="#8AC7F5" />
                <SolidColorBrush x:Key="Badge" Color="#38312A" />
                <SolidColorBrush x:Key="LiveBadge" Color="#254637" />
                <SolidColorBrush x:Key="ScreenFrame" Color="#100F0E" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="LightTheme">
                <SolidColorBrush x:Key="WindowBackground" Color="#F5F3EF" />
                <SolidColorBrush x:Key="MainText" Color="#262420" />
                <SolidColorBrush x:Key="MutedText" Color="#5D5953" />
                <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
                <SolidColorBrush x:Key="Outline" Color="#D7D2C9" />
                <SolidColorBrush x:Key="ControlOutline" Color="#6F6A62" />
                <SolidColorBrush x:Key="Hover" Color="#FCF7EF" />
                <SolidColorBrush x:Key="Selected" Color="#FFF3E0" />
                <SolidColorBrush x:Key="SelectedOutline" Color="#A46320" />
                <SolidColorBrush x:Key="Accent" Color="#8A4C12" />
                <SolidColorBrush x:Key="Focus" Color="#2C6087" />
                <SolidColorBrush x:Key="Badge" Color="#E9E3D8" />
                <SolidColorBrush x:Key="LiveBadge" Color="#D1E9D9" />
                <SolidColorBrush x:Key="ScreenFrame" Color="#2B2824" />
            </ResourceDictionary>
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
            </Style>
            <Style x:Key="DisplayChoice" TargetType="RadioButton">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Foreground" Value="{DynamicResource MainText}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Card" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}"
                                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="16" Height="16" Margin="0,0,9,0">
                                        <Ellipse x:Name="Ring" Stroke="{DynamicResource ControlOutline}" StrokeThickness="1.5" />
                                        <Ellipse x:Name="Dot" Margin="4" Fill="{DynamicResource Accent}" Visibility="Collapsed" />
                                    </Grid>
                                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Selected}" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SelectedOutline}" />
                                    <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Focus}" />
                                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="Card" Property="Padding" Value="11,9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SettingsCheck" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource MainText}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Grid Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                                    <Border x:Name="Box" BorderBrush="{DynamicResource ControlOutline}"
                                            BorderThickness="1.5" CornerRadius="3" />
                                    <Path x:Name="Tick" Data="M 4,8 L 7,11 L 12,5" Stroke="{DynamicResource Accent}"
                                          StrokeThickness="1.6" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Selected}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Focus}" />
                                    <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="LayoutButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource MainText}" />
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="Padding" Value="9,3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Card" Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Outline}" BorderThickness="1"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Focus}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Card" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="22,19,22,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="StatusDock Settings" FontWeight="SemiBold" FontSize="29" />
                    <TextBlock Text="Flipper display and Windows appearance" Foreground="{DynamicResource MutedText}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right" VerticalAlignment="Top" Margin="0,6,0,0"
                        Padding="9,4" CornerRadius="9">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Badge}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=DataLabel}" Value="Live">
                                    <Setter Property="Background" Value="{DynamicResource LiveBadge}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="DataLabel" Text="Sample data" Style="{StaticResource SectionLabel}" />
                </Border>
            </DockPanel>
            <DockPanel Margin="0,21,0,7">
                <TextBlock DockPanel.Dock="Right" Text="128 × 64 px" Style="{StaticResource SectionLabel}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PREVIEW" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="NoLiveLabel" Text="No live data" Margin="12,0,0,0"
                               Foreground="{DynamicResource Accent}" Style="{StaticResource SectionLabel}" />
                </StackPanel>
            </DockPanel>
            <Border Background="{DynamicResource ScreenFrame}" CornerRadius="12" Padding="12">
                <Image x:Name="PreviewImage" MaxWidth="512" MaxHeight="256" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       AutomationProperties.Name="Flipper display preview" />
            </Border>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="22,0,22,16">
            <TextBlock Text="DISPLAY" Margin="0,19,0,7" Style="{StaticResource SectionLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="StatsChoice" GroupName="Display" Content="PC Stats"
                             Style="{StaticResource DisplayChoice}" Checked="OnChoiceChanged" />
                <RadioButton x:Name="ClockChoice" Grid.Column="2" GroupName="Display" Content="Large Clock"
                             Style="{StaticResource DisplayChoice}" Checked="OnChoiceChanged" />
            </Grid>
            <Border Margin="0,10,0,0" Padding="12,10" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <CheckBox x:Name="SecondsChoice" Content="Show seconds" Style="{StaticResource SettingsCheck}"
                              Checked="OnChoiceChanged" Unchecked="OnChoiceChanged" />
                    <CheckBox x:Name="InvertChoice" Content="Invert Flipper display" Margin="0,10,0,0"
                              Style="{StaticResource SettingsCheck}" Checked="OnChoiceChanged" Unchecked="OnChoiceChanged" />
                </StackPanel>
            </Border>
            <StackPanel x:Name="LayoutSection">
                <DockPanel Margin="0,19,0,7">
                    <Button DockPanel.Dock="Right" Content="Reset layout" Style="{StaticResource LayoutButton}"
                            Click="OnResetLayout" />
                    <TextBlock Text="LAYOUT" VerticalAlignment="Center" Style="{StaticResource SectionLabel}" />
                </DockPanel>
                <Border Padding="12,10" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Clock alignment" Margin="0,0,0,6" />
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="AlignLeft" GroupName="Alignment" Content="Left" Margin="0,0,5,0"
                                         Style="{StaticResource DisplayChoice}" Checked="OnLayoutChoice" />
                            <RadioButton x:Name="AlignCenter" GroupName="Alignment" Content="Center" Margin="0,0,5,0"
                                         Style="{StaticResource DisplayChoice}" Checked="OnLayoutChoice" />
                            <RadioButton x:Name="AlignRight" GroupName="Alignment" Content="Right"
                                         Style="{StaticResource DisplayChoice}" Checked="OnLayoutChoice" />
                        </UniformGrid>
                        <TextBlock Text="Metric order" Margin="0,12,0,6" />
                        <DockPanel Margin="0,0,0,0">
                            <Button x:Name="Row0Down" DockPanel.Dock="Right" Content="↓" Tag="0"
                                    Style="{StaticResource LayoutButton}" Click="OnRowDown" />
                            <Button x:Name="Row0Up" DockPanel.Dock="Right" Content="↑" Tag="0" Margin="0,0,6,0"
                                    Style="{StaticResource LayoutButton}" Click="OnRowUp" />
                            <TextBlock x:Name="Row0Label" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,6,0,0">
                            <Button x:Name="Row1Down" DockPanel.Dock="Right" Content="↓" Tag="1"
                                    Style="{StaticResource LayoutButton}" Click="OnRowDown" />
                            <Button x:Name="Row1Up" DockPanel.Dock="Right" Content="↑" Tag="1" Margin="0,0,6,0"
                                    Style="{StaticResource LayoutButton}" Click="OnRowUp" />
                            <TextBlock x:Name="Row1Label" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,6,0,0">
                            <Button x:Name="Row2Down" DockPanel.Dock="Right" Content="↓" Tag="2"
                                    Style="{StaticResource LayoutButton}" Click="OnRowDown" />
                            <Button x:Name="Row2Up" DockPanel.Dock="Right" Content="↑" Tag="2" Margin="0,0,6,0"
                                    Style="{StaticResource LayoutButton}" Click="OnRowUp" />
                            <TextBlock x:Name="Row2Label" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Metric display" Margin="0,12,0,6" />
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="ShowBars" GroupName="MetricDisplay" Content="Bars + numbers"
                                         Margin="0,0,5,0" Style="{StaticResource DisplayChoice}" Checked="OnLayoutChoice" />
                            <RadioButton x:Name="NumbersOnly" GroupName="MetricDisplay" Content="Numbers only"
                                         Style="{StaticResource DisplayChoice}" Checked="OnLayoutChoice" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Text="WINDOWS THEME" Margin="0,19,0,7" Style="{StaticResource SectionLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="DarkThemeChoice" GroupName="WindowsTheme" Content="Dark"
                             Style="{StaticResource DisplayChoice}" Checked="OnThemeChanged" />
                <RadioButton x:Name="LightThemeChoice" Grid.Column="2" GroupName="WindowsTheme" Content="Light"
                             Style="{StaticResource DisplayChoice}" Checked="OnThemeChanged" />
            </Grid>
            <TextBlock x:Name="SaveStatus" Margin="0,12,0,0" Foreground="{DynamicResource MutedText}" FontSize="12"
                       Text="Settings are saved automatically in this folder." TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
